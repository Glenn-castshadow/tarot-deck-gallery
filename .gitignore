# Model trial images and copied references stay local; prompts and results are tracked.
evals/tarot-images/runs/**/images/
evals/tarot-images/runs/**/references/

# Divination generation masters remain on the NAS; keep the prompt manifest.
output/imagegen/divination-v2/*.webp
output/imagegen/divination-v2/review/
# Source art for the hero and logo stays local; `git add -A` has swept it in twice.
output/imagegen/*.png
tmp/imagegen/
output/daily-prose/
output/weekly-prose/

# Superpowers SDD scratch workspace (ledger, briefs, review packages)
.superpowers/

# Django app local state
server/ishtar/.venv/
server/ishtar/staticfiles/
server/ishtar/*.sqlite3
server/ishtar/*.sqlite3-*
server/ishtar/.dev-secret-key
